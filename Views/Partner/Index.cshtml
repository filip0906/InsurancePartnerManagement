@model IEnumerable<InsurancePartnerManagement.Models.Partner>

<h1>Lista partnera</h1>

<a href="/Partner/Create" class="btn btn-primary mb-3">Dodaj novog partnera</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Partner Number</th>
            <th>Partner Type</th>
            <th>Created At</th>
            <th>Foreign</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var partner in Model)
        {
            <tr data-toggle="modal" data-target="#partnerModal" data-id="@partner.Id">
                <td>
                    @(partner.TotalPolicies > 5 || partner.TotalPolicyAmount > 5000 ? "*" : "")
                    @partner.FirstName @partner.LastName
                </td>
                <td>@partner.PartnerNumber</td>
                <td>@(partner.PartnerTypeId == 1 ? "Personal" : "Legal")</td>
                <td>@partner.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                <td>@(partner.IsForeign ? "Yes" : "No")</td>
                <td>
                    <a href="/Policy/Create?partnerId=@partner.Id" class="btn btn-sm btn-primary">Dodaj policu</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="partnerModal" tabindex="-1" role="dialog" aria-labelledby="partnerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="partnerModalLabel">Detalji partnera</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Detalji partnera će biti učitani putem JavaScript-a -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#partnerModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var partnerId = button.data('id');

                $.get('/Partner/Details/' + partnerId, function (data) {
                    $('#partnerModal .modal-body').html(data);
                });
            });
        });
    </script>
}
